# ==============================================================================
# Contrib Environment Variables Configuration Template
# ==============================================================================

# [Database Configuration]
# Local Docker & Spring Boot datasource settings:
POSTGRES_DB=contribution
POSTGRES_USER=contribution
POSTGRES_PASSWORD=contribution
DATABASE_URL=jdbc:postgresql://localhost:5432/contribution
# For Cloud / Render / Neon PostgreSQL:
# DATABASE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require&channel_binding=require
# POSTGRES_USER=<db-user>
# POSTGRES_PASSWORD=<db-password>

# [Backend Security & GitHub OAuth]
SERVER_PORT=8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
GITHUB_RATE_LIMIT_MAX_ATTEMPTS=4
GITHUB_RATE_LIMIT_BASE_BACKOFF=PT1S
GITHUB_RATE_LIMIT_MAX_BACKOFF=PT30S
ANALYSIS_DISPATCH_ENABLED=true
ANALYSIS_DISPATCH_INTERVAL_MS=1000
ANALYSIS_JOB_LEASE=PT5M

# [AI Provider & OpenRouter]
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Contrib

# [Production Operations]
# Set SPRING_PROFILES_ACTIVE=prod on Render or production deployment platforms
SPRING_PROFILES_ACTIVE=prod
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=2
POSTGRES_BACKUP_URL=
MONITORING_TOKEN=

# [Frontend Client Settings]
# Base URL pointing to the backend API service (Render: https://contrib-backend.onrender.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# [Base Sepolia Smart Contract & Blockchain]
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
ATTESTATION_CONTRACT_ADDRESS=0xEb1C46cd85512b27c5ac5Aa001fcaa9A91B187d1
BLOCKCHAIN_CHAIN_ID=84532
BLOCKCHAIN_NETWORK=base-sepolia
BLOCKCHAIN_RECEIPT_POLL_ENABLED=true
BLOCKCHAIN_RECEIPT_POLL_INTERVAL_MS=3000
